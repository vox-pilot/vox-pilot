{
  "name": "vox-pilot",
  "version": "0.1.0",
  "description": "One-command setup for Vox Pilot — AI-powered voice control for your desktop",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "vox-pilot": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": ["voice-control", "ai-agent", "mcp", "claude-code", "codex", "desktop-automation"],
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
