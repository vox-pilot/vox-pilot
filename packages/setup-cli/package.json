{
  "name": "vox-pilot",
  "version": "0.1.0",
  "description": "One-command setup for Vox Pilot — AI-powered voice control for your desktop",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "vox-pilot": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": ["mcp", "vox-pilot", "setup", "cli"],
  "author": "Vox Pilot Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vox-pilot/vox-pilot",
    "directory": "packages/setup-cli"
  },
  "homepage": "https://github.com/vox-pilot/vox-pilot#readme",
  "bugs": {
    "url": "https://github.com/vox-pilot/vox-pilot/issues"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
